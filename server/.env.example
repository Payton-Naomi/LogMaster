# ===== LogMaster Docker 部署配置模板 =====
# 使用方法：复制本文件为 .env，然后填写下面的真实值。
#   cp .env.example .env

# 数据库密码：只允许字母和数字，不要用 @ : / # ? 等特殊字符，否则连接串会出错
DB_PASSWORD=改成你的密码仅字母数字

# 公网访问地址（试用期用 IP + 端口即可）
PUBLIC_BASE_URL=http://121.43.234.112:8080

# 飞书应用凭证（app_id 一般已固定；secret 别外泄）
FEISHU_APP_ID=cli_aac4efb073789bd0
FEISHU_APP_SECRET=改成你的飞书secret

# 飞书 OAuth 回调地址，必须与飞书开放平台后台登记的一致
FEISHU_REDIRECT_URI=http://121.43.234.112:8080/api/auth/callback

# 自动成为管理员的飞书姓名（对应你在飞书上的真实姓名）
# 超级管理员 Open ID，多个用英文逗号分隔；优先于姓名，避免同名误匹配
FEISHU_SUPER_ADMIN_OPEN_IDS=
# 超级管理员飞书姓名，多个用英文逗号分隔；Open ID 和姓名都为空时首位飞书登录用户成为超管
FEISHU_SUPER_ADMIN_NAMES=改成你的飞书姓名

# ===== 外包账号登录 =====
# 外包账号注册、邮箱密码登录、修改邮箱和修改密码不需要 Redis、SMTP 或专用密钥。
# 首次启动时后端会自动执行 045_external_password_accounts.sql；请保持 PostgreSQL 数据卷持久化。

# ===== AI 分析（可选；不配置 LLM_API_BASE_URL 则 AI 分析不启用，关键字规则兜底） =====
# 大模型 OpenAI 兼容接口地址（末尾不要带 /chat/completions）
#   通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek：https://api.deepseek.com/v1
#   本地 Ollama：http://<ollama主机>:11434/v1
LLM_API_BASE_URL=
# 大模型 API Key（Ollama 可留空）
LLM_API_KEY=
# 模型名，例如 qwen-plus / deepseek-chat / llama3
LLM_MODEL=qwen-plus
# 单次 AI 分析超时（秒）
LLM_TIMEOUT_SECONDS=120
# 单次最多送入模型的命中条数
LLM_MAX_MATCHES=50
# 单次送入模型的最大输入字节数
LLM_MAX_INPUT_BYTES=200000

# ===== 解析任务调度 =====
# 这些值控制后台解压、关键字解析和 AI 分析的并发与容量。
# 并发上限超过时任务会继续排队；文件数或字节数超过容量上限时任务会失败。
# 规则解析 Worker 数量：同时执行多少个解压/关键字解析任务。提高会增加 CPU、内存和磁盘 IO；默认 2。
MAX_PARSE_WORKERS=2
# AI Worker 数量：同时执行多少个 AI 分析作业。每个 Worker 一次只处理一个作业；默认 1。
MAX_AI_WORKERS=1
# 单个任务最多自动恢复次数：Worker 崩溃或任务租约过期后自动重试；达到次数后标记失败；默认 3。
MAX_PARSE_ATTEMPTS=3
# 单用户同时运行的解析任务上限：超过此数量的该用户任务会排队；默认 1。
MAX_PARSE_PER_USER=1
# 单项目同时运行的解析任务上限：避免单个项目占满全部 Worker；默认 2。
MAX_PARSE_PER_PROJECT=2
# 单个任务解压后允许处理的最大文件数：超过后任务失败；默认 10000。
MAX_FILES_PER_PARSE_TASK=10000
# 单个任务解压后允许处理的最大总字节数：超过后任务失败；默认 8 GiB，即 8589934592 字节。
MAX_BYTES_PER_PARSE_TASK=8589934592

# 上传、解压和 HTTP 服务限制
# 日志文件在服务器上的存储目录。Docker 部署中由 Compose 固定挂载到持久化数据卷。
LOG_STORAGE_DIR=data/logs
# 一次网页或接口上传允许接收的原始文件总大小；默认 2 GiB，即 2147483648 字节。
MAX_UPLOAD_BYTES=2147483648
# 一次网页或接口上传最多允许携带的文件数量；默认 100。
MAX_FILES_PER_UPLOAD=100
# 解压后的内容总大小上限，用于防止压缩包解压炸弹；默认 8 GiB。
MAX_EXTRACT_BYTES=8589934592
# 接收 HTTP 请求头的最长时间；防止慢速请求长期占用连接；默认 10 秒。
HTTP_READ_HEADER_TIMEOUT_SECONDS=10
# 一个 HTTP 请求读取完整请求体的最长时间；大日志上传默认允许 30 分钟。
HTTP_READ_TIMEOUT_SECONDS=1800
# 服务端向客户端写回 HTTP 响应的最长时间；默认 10 分钟。
HTTP_WRITE_TIMEOUT_SECONDS=600
# TCP 连接完全没有请求活动时可保持的最长时间；默认 120 秒。
HTTP_IDLE_TIMEOUT_SECONDS=120
# 收到停止信号后，服务等待正在处理 HTTP 请求结束的最长时间；默认 30 秒。
HTTP_SHUTDOWN_TIMEOUT_SECONDS=30

# ===== 采集端鉴权（可选；两项必须同时配置） =====
# 采集端请求携带的 Bearer Token。留空时仅允许内置采集端 Token；不要提交真实 Token。
LOGMASTER_UPLOAD_TOKEN=
# 使用上述 Token 上传时归属的企业用户飞书 Open ID；与 Token 必须同时填写。
LOGMASTER_UPLOAD_OWNER_OPEN_ID=
# 每个文件允许的 AI 模型最大输出 token 数（回退默认值；管理员可在后台「AI 分析设置」里改）
# 每个日志文件允许 AI 返回的最大 token 数；管理员可在后台 AI 分析设置中调整；默认 20000。
AI_MAX_TOKENS_PER_FILE=20000
# 每个用户每天的 AI token 配额（0 表示不限制，管理员可在后台修改）
# 每个用户每天可消耗的 AI token 配额；0 表示不限制；管理员可在后台调整；默认 1000000。
AI_DAILY_TOKEN_QUOTA=1000000
# 用于加密管理员在后台保存的大模型 API Key，必须使用稳定的随机密钥
LOGMASTER_CONFIG_ENCRYPTION_KEY=
