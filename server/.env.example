# ===== LogMaster Docker 部署配置模板 =====
# 使用方法：复制本文件为 .env，然后填写下面的真实值。
#   cp .env.example .env

# 数据库密码：只允许字母和数字，不要用 @ : / # ? 等特殊字符，否则连接串会出错
DB_PASSWORD=改成你的密码仅字母数字

# 公网访问地址（试用期用 IP + 端口即可）
PUBLIC_BASE_URL=http://121.43.234.112:8080

# 飞书应用凭证（app_id 一般已固定；secret 别外泄）
FEISHU_APP_ID=cli_aac4efb073789bd0
FEISHU_APP_SECRET=改成你的飞书secret

# 飞书 OAuth 回调地址，必须与飞书开放平台后台登记的一致
FEISHU_REDIRECT_URI=http://121.43.234.112:8080/api/auth/callback

# 自动成为管理员的飞书姓名（对应你在飞书上的真实姓名）
FEISHU_SUPER_ADMIN_NAMES=改成你的飞书姓名

# ===== AI 分析（可选；不配置 LLM_API_BASE_URL 则 AI 分析不启用，关键字规则兜底） =====
# 大模型 OpenAI 兼容接口地址（末尾不要带 /chat/completions）
#   通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek：https://api.deepseek.com/v1
#   本地 Ollama：http://<ollama主机>:11434/v1
LLM_API_BASE_URL=
# 大模型 API Key（Ollama 可留空）
LLM_API_KEY=
# 模型名，例如 qwen-plus / deepseek-chat / llama3
LLM_MODEL=qwen-plus
# 单次 AI 分析超时（秒）
LLM_TIMEOUT_SECONDS=120
# 单次最多送入模型的命中条数
LLM_MAX_MATCHES=50
# 单次送入模型的最大输入字节数
LLM_MAX_INPUT_BYTES=200000
# 每个文件允许的 AI 模型最大输出 token 数（回退默认值；管理员可在后台「AI 分析设置」里改）
AI_MAX_TOKENS_PER_FILE=20000
# 每个用户每天的 AI token 配额（0 表示不限制，管理员可在后台修改）
AI_DAILY_TOKEN_QUOTA=1000000
# 用于加密管理员在后台保存的大模型 API Key，必须使用稳定的随机密钥
LOGMASTER_CONFIG_ENCRYPTION_KEY=
