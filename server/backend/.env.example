# ===== LogMaster 后端环境变量示例 =====
# 复制本文件为 .env 后按需填写；后端本身不自动读取 .env，需通过 shell/systemd/Docker 注入环境变量。

# PostgreSQL 连接串。格式：postgres://用户名:密码@主机:端口/库名
# 密码含 @ : / # ? 等特殊字符时必须做 URL 编码。
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/logmaster?sslmode=disable

# 飞书开放平台应用的 App ID
FEISHU_APP_ID=cli_aac4efb073789bd0
# 飞书应用的 App Secret（密钥，勿外泄）
FEISHU_APP_SECRET=
# 飞书 OAuth 回调地址，必须与飞书开放平台后台登记的「重定向 URL」逐字符一致
FEISHU_REDIRECT_URI=http://localhost:8080/api/auth/callback

# 飞书职位自动角色固定规则：含“主任”为 super_admin，含“高级”为 admin，
# 含“软件工程师”或“硬件工程师”为 developer，其他为 user。
# 手工设置的角色不会被飞书同步覆盖。

# 对外访问的基础地址（用于生成分析结果链接等）
PUBLIC_BASE_URL=http://localhost:8080
# 原始日志存储目录（服务进程需有写权限）
LOG_STORAGE_DIR=data/logs
# 单次上传最大字节数（默认 2GB）
MAX_UPLOAD_BYTES=2147483648
# 单次解压最大字节数（默认 8GB）
MAX_EXTRACT_BYTES=8589934592
# 服务端同时执行的上传准备/日志解析 Worker 数（默认 2）
MAX_PARSE_WORKERS=2
# 服务端同时执行的 AI Worker 数（默认 1）
MAX_AI_WORKERS=1
# Worker 异常退出或租约过期后，单个任务最多自动接管执行次数（默认 3）
MAX_PARSE_ATTEMPTS=3
# 单个用户同时运行的解析任务数
MAX_PARSE_PER_USER=1
# 单个项目同时运行的解析任务数
MAX_PARSE_PER_PROJECT=2
# 单个解析任务解压后允许的最大日志文件数
MAX_FILES_PER_PARSE_TASK=10000
# 单个解析任务解压后允许的最大总字节数（默认 8GB）
MAX_BYTES_PER_PARSE_TASK=8589934592

# 外部 Agent 分析接口地址（旧方式）；留空则禁用外部 Agent
AGENT_ANALYSIS_URL=
# 调用外部 Agent 时使用的鉴权 Token
AGENT_ANALYSIS_TOKEN=
# 调用外部 Agent 的超时（秒）
AGENT_ANALYSIS_TIMEOUT_SECONDS=60

# ===== AI 分析（直连大模型；留空 LLM_API_BASE_URL 则不启用，关键字规则兜底） =====
# OpenAI 兼容接口地址，末尾不要带 /chat/completions。
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek：https://api.deepseek.com/v1
# 本地 Ollama：http://<主机>:11434/v1
LLM_API_BASE_URL=
# 大模型 API Key（Ollama 可留空）
LLM_API_KEY=
# 模型名，例如 qwen-plus / deepseek-chat / gpt-5.5
LLM_MODEL=qwen-plus
# 单次 AI 分析超时（秒）
LLM_TIMEOUT_SECONDS=120
# 单次最多送入模型的命中日志条数
LLM_MAX_MATCHES=50
# 单次送入模型的最大输入字节数
LLM_MAX_INPUT_BYTES=200000

# 每个文件允许的 AI 模型最大输出 token 数（回退默认值；管理员可在后台「AI 分析设置」里改）
AI_MAX_TOKENS_PER_FILE=20000
# 每个用户每天的 AI token 配额（回退默认值；0 表示不限制）
AI_DAILY_TOKEN_QUOTA=1000000
# 用于加密管理员在后台保存的大模型 API Key，必须使用稳定的随机密钥
LOGMASTER_CONFIG_ENCRYPTION_KEY=

# 前端构建产物目录（相对 backend 或绝对路径均可）
FRONTEND_DIST_DIR=frontend/dist

# 采集端上传日志用的自定义鉴权 Token（Bearer）。留空则只用内置 Token logmaster-internal-collector-v1。
# 填写后，采集端必须以 `Authorization: Bearer <此Token>` 上传，数据才会被接受。
LOGMASTER_UPLOAD_TOKEN=
# 与 LOGMASTER_UPLOAD_TOKEN 配套：用该 Token 上传的数据归属到哪个飞书用户的 open_id。
# 两者必须同时填写才生效；只填 Token 不填 open_id 时，自定义 Token 会被禁用（回退到内置 Token）。
LOGMASTER_UPLOAD_OWNER_OPEN_ID=
